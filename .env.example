# Haat settings. Copy to .env and edit:  cp .env.example .env

# --- Database (Postgres) ---
POSTGRES_USER=haat
POSTGRES_PASSWORD=haat
POSTGRES_DB=haat
# Used when running the API outside Docker. Inside Docker this is set to the `db` service automatically.
DATABASE_URL=postgresql://haat:haat@localhost:5432/haat
# Connections per API worker process (total = WEB_CONCURRENCY x DB_POOL_MAX).
DB_POOL_MIN=5
DB_POOL_MAX=20

# --- Redis (cache + background jobs) ---
# Used outside Docker. Inside Docker this is set to the `redis` service automatically.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

# --- API ---
# Number of API worker processes (about 1-2 per CPU core).
WEB_CONCURRENCY=4
CORS_ORIGINS=*
# Images are served from this CDN when set, e.g. https://cdn.example.com
CDN_URL=
# Signed-in user until login is added.
DEMO_USER_ID=1

# --- Web ---
# Port the site is published on: http://localhost:3000
WEB_PORT=3000
